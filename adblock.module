#!name=Infinitty Adblock
#!desc=Safari + app ad/tracker blocking for iPhone & iPad. No MITM. Stacks with your existing nodes and the Peacock config.
#!author=Infinitty35
#!category=Advertising
#!repo=https://github.com/Infinitty35/shadowrocket-adblock
#!updated=2026-09-15

[Rule]
# ========== ALLOW — first match wins. Do not let ad lists kill these. ==========
# Apple / iCloud / App Store / iMessage / FaceTime / Captive
DOMAIN-SUFFIX,apple.com,DIRECT
DOMAIN-SUFFIX,icloud.com,DIRECT
DOMAIN-SUFFIX,icloud-content.com,DIRECT
DOMAIN-SUFFIX,cdn-apple.com,DIRECT
DOMAIN-SUFFIX,apple-dns.net,DIRECT
DOMAIN-SUFFIX,mzstatic.com,DIRECT
DOMAIN-SUFFIX,appsto.re,DIRECT
DOMAIN-SUFFIX,itunes.com,DIRECT
DOMAIN-SUFFIX,aaplimg.com,DIRECT
DOMAIN,captive.apple.com,DIRECT
DOMAIN,sequoia.apple.com,DIRECT

# Common APIs that aggressive lists sometimes flag
DOMAIN-SUFFIX,googleapis.com,DIRECT
DOMAIN-SUFFIX,gstatic.com,DIRECT
DOMAIN-SUFFIX,googleusercontent.com,DIRECT
DOMAIN-SUFFIX,ggpht.com,DIRECT
DOMAIN-SUFFIX,gvt1.com,DIRECT
DOMAIN-SUFFIX,gvt2.com,DIRECT
DOMAIN-SUFFIX,youtu.be,DIRECT
DOMAIN-SUFFIX,youtube.com,DIRECT
DOMAIN-SUFFIX,googlevideo.com,DIRECT
DOMAIN-SUFFIX,ytimg.com,DIRECT

# Peacock playback
DOMAIN-SUFFIX,play.ovp.peacocktv.com,DIRECT
DOMAIN-SUFFIX,ovp.peacocktv.com,DIRECT
DOMAIN-SUFFIX,atom.peacocktv.com,DIRECT
DOMAIN-SUFFIX,mytv.clients.peacocktv.com,DIRECT
DOMAIN-SUFFIX,bff-ext.clients.peacocktv.com,DIRECT
DOMAIN-SUFFIX,imageservice.disco.peacocktv.com,DIRECT
DOMAIN-SUFFIX,meg.disco.peacocktv.com,DIRECT
DOMAIN-SUFFIX,cybertron.id.peacocktv.com,DIRECT
DOMAIN-SUFFIX,pconfig-prd.cdn.peacocktv.com,DIRECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-mc)),DIRECT
AND,((DOMAIN-SUFFIX,prd.pck.netskrt.net),(DOMAIN-KEYWORD,-prd-ns)),DIRECT

# Cable login (Adobe Pass) + TVE apps + MVPD
DOMAIN-SUFFIX,adobe.com,DIRECT
DOMAIN-SUFFIX,adobe.io,DIRECT
DOMAIN-SUFFIX,adobepass.com,DIRECT
DOMAIN-SUFFIX,auth.adobe.com,DIRECT
DOMAIN,sp.auth.adobe.com,DIRECT
DOMAIN,api.auth.adobe.com,DIRECT
DOMAIN-SUFFIX,aetv.com,DIRECT
DOMAIN-SUFFIX,history.com,DIRECT
DOMAIN-SUFFIX,mylifetime.com,DIRECT
DOMAIN-SUFFIX,fyi.tv,DIRECT
DOMAIN-SUFFIX,aetn.com,DIRECT
DOMAIN-SUFFIX,theplatform.com,DIRECT
DOMAIN-SUFFIX,tlc.com,DIRECT
DOMAIN-SUFFIX,discovery.com,DIRECT
DOMAIN-SUFFIX,discoveryplus.com,DIRECT
DOMAIN-SUFFIX,disco-api.com,DIRECT
DOMAIN-SUFFIX,foodnetwork.com,DIRECT
DOMAIN-SUFFIX,hgtv.com,DIRECT
DOMAIN-SUFFIX,investigationdiscovery.com,DIRECT
DOMAIN-SUFFIX,animalplanet.com,DIRECT
DOMAIN-SUFFIX,xfinity.com,DIRECT
DOMAIN-SUFFIX,comcast.net,DIRECT
DOMAIN-SUFFIX,spectrum.com,DIRECT
DOMAIN-SUFFIX,akamaihd.net,DIRECT
DOMAIN-SUFFIX,akamaized.net,DIRECT
DOMAIN-SUFFIX,conviva.com,DIRECT
DOMAIN-SUFFIX,brightcove.net,DIRECT
DOMAIN-SUFFIX,zencdn.net,DIRECT

# ========== CUSTOM — Peacock SSAI shards ==========
DOMAIN-SUFFIX,ssai.peacocktv.com,REJECT
DOMAIN,mt.ssai.peacocktv.com,REJECT
DOMAIN-KEYWORD,.mediatailor.,REJECT
DOMAIN,vac.peacocktv.com,REJECT
DOMAIN,sas.peacocktv.com,REJECT
DOMAIN,video-ads-module.ad-tech.nbcuni.com,REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-cf)),REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-cc)),REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-ak)),REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-ph)),REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-dc)),REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-at)),REJECT
AND,((DOMAIN-SUFFIX,cdn.peacocktv.com),(DOMAIN-KEYWORD,-prd-fy)),REJECT
DOMAIN-SUFFIX,prd.pck.netskrt.net,REJECT

